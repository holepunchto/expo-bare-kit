{
  "name": "expo-bare-kit",
  "version": "0.2.0",
  "description": "Bare Kit for Expo",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./metro": "./metro.js",
    "./workers/*": {
      "types": "./workers.d.ts"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "metro.js",
    "workers.d.ts",
    "app.plugin.js",
    "plugin"
  ],
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/expo-bare-kit.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/expo-bare-kit/issues"
  },
  "homepage": "https://github.com/holepunchto/expo-bare-kit#readme",
  "dependencies": {
    "bare-bundle": "^1.11.0",
    "bare-stow": "^0.2.0",
    "bare-stow-host": "^0.1.0",
    "bare-stow-target-react-native": "^0.2.0"
  },
  "peerDependencies": {
    "expo": ">=47.0.0",
    "react": "*",
    "react-native": "*",
    "react-native-bare-kit": ">=0.5.0"
  },
  "devDependencies": {
    "lunte": "^1.8.6",
    "prettier": "^3.5.2",
    "prettier-config-holepunch": "^2.0.0"
  }
}
